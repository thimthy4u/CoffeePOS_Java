<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>


<BorderPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="coffee_pos.controller.MainViewController">
    <left>
        <VBox spacing="8" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <children>
                <ImageView fitHeight="138.0" fitWidth="167.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../icons/w-logo.png" />
                    </image>
                </ImageView>
                <Button fx:id="posButton" alignment="CENTER_LEFT" contentDisplay="LEFT" graphicTextGap="12" onAction="#handlePOS" prefHeight="45" prefWidth="140" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 4, 0, 0, 2);" text="POS">
                    <graphic>
                        <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">
                            <image>
                                <Image url="@../icons/cashier.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="productsButton" alignment="CENTER_LEFT" contentDisplay="LEFT" graphicTextGap="12" onAction="#handleProducts" prefHeight="45" prefWidth="140" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 3, 0, 0, 1);" text="Products">
                    <graphic>
                        <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">
                            <image>
                                <Image url="@../icons/product-management.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="categoryButton" alignment="CENTER_LEFT" contentDisplay="LEFT" graphicTextGap="12" onAction="#handleCategory" prefHeight="45" prefWidth="140" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 3, 0, 0, 1);" text="Category">
                    <graphic>
                        <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">
                            <image>
                                <Image url="@../icons/categories.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="ordersButton" alignment="CENTER_LEFT" contentDisplay="LEFT" graphicTextGap="12" onAction="#handleOrders" prefHeight="45" prefWidth="140" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 3, 0, 0, 1);" text="Orders">
                    <graphic>
                        <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">
                            <image>
                                <Image url="@../icons/order.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="reportButton" alignment="CENTER_LEFT" contentDisplay="LEFT" graphicTextGap="12" onAction="#handleReport" prefHeight="45" prefWidth="140" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 3, 0, 0, 1);" text="Report">
                    <graphic>
                        <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">
                            <image>
                                <Image url="@../icons/reports.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="userManagementButton" alignment="CENTER_LEFT" contentDisplay="LEFT" graphicTextGap="12" onAction="#handleUserManagement" prefHeight="45" prefWidth="140" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 3, 0, 0, 1);" text="Users">
                    <graphic>
                        <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">
                            <image>
                                <Image url="@../icons/user.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="settingsButton" alignment="CENTER_LEFT" contentDisplay="LEFT" graphicTextGap="12" onAction="#handleSettings" prefHeight="45" prefWidth="140" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 3, 0, 0, 1);" text="Settings">
                    <graphic>
                        <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">
                            <image>
                                <Image url="@../icons/emp.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                
                <VBox VBox.vgrow="ALWAYS"  />
                
                <Button fx:id="logoutButton" graphicTextGap="12" onAction="#handleLogout" prefHeight="45" prefWidth="140" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 4, 0, 0, 2);" text="Logout">
                    <graphic>
                        <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">
                            <image>
                                <Image url="@../icons/logout.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </children>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #FFF;" />
    </center>
</BorderPane>


