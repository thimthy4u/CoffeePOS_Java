<AnchorPane prefHeight="500.0" style="-fx-background-color: #f5f1eb;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="coffee_pos.controller.ProductController">
    <children>
        <AnchorPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox alignment="TOP_CENTER" spacing="15.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                    <children>
                        <!-- Header Section -->
                        <VBox alignment="CENTER" spacing="5.0" style="-fx-background-color: #8B4513; -fx-background-radius: 10; -fx-padding: 20;">
                            <children>
                                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #F5DEB3;" text="Product Management" />
                                <Label style="-fx-font-size: 14px; -fx-text-fill: #DEB887;" text="Manage your coffee shop inventory" />
                            </children>
                        </VBox>
                                
                        <!-- Main Content Section -->
                        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                            <children>
                                <!-- Left Side: Input Form -->
                                <VBox spacing="15.0" style="-fx-background-color: #FAEBD7; -fx-background-radius: 10; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(139,69,19,0.2), 5, 0, 0, 2);" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #8B4513;" text="Product Details" />
                                                
                                        <GridPane hgap="15.0" vgap="15.0">
                                            <children>
                                                <Label style="-fx-font-weight: bold; -fx-text-fill: #A0522D;" text="Product Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                                <TextField fx:id="nameField" prefWidth="200.0" promptText="Enter product name" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #D2B48C; -fx-padding: 8; -fx-background-color: white;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                                        
                                                <Label style="-fx-font-weight: bold; -fx-text-fill: #A0522D;" text="Price ($):" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                                <TextField fx:id="priceField" prefWidth="200.0" promptText="0.00" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #D2B48C; -fx-padding: 8; -fx-background-color: white;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                        
                                                <Label style="-fx-font-weight: bold; -fx-text-fill: #A0522D;" text="Stock Quantity:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                                <TextField fx:id="stockField" prefWidth="200.0" promptText="0" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #D2B48C; -fx-padding: 8; -fx-background-color: white;" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                                        
                                                <Label style="-fx-font-weight: bold; -fx-text-fill: #A0522D;" text="Category:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                                <ComboBox fx:id="categoryComboBox" prefWidth="200.0" promptText="Select category" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #D2B48C; -fx-background-color: white;" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                                        
                                                <Label style="-fx-font-weight: bold; -fx-text-fill: #A0522D;" text="Product Image:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                                <Button onAction="#handleChooseImage" prefWidth="200.0" style="-fx-background-color: #CD853F; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 8;" text="📁 Choose Image..." GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                            </children>
                                            <columnConstraints>
                                                <ColumnConstraints minWidth="120.0" />
                                                <ColumnConstraints minWidth="200.0" />
                                            </columnConstraints>
                                            <rowConstraints>
                                                <RowConstraints />
                                                <RowConstraints />
                                                <RowConstraints />
                                                <RowConstraints />
                                                <RowConstraints />
                                            </rowConstraints>
                                        </GridPane>
                                                
                                        <!-- Image Preview Section -->
                                        <VBox alignment="CENTER" spacing="10.0" VBox.vgrow="ALWAYS" >
                                            <children>
                                                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B4513;" text="Image Preview" />
                                                <VBox alignment="CENTER" style="-fx-border-color: #D2B48C; -fx-border-style: dashed; -fx-border-width: 2; -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 15; -fx-background-color: white;">
                                                    <children>
                                                        <ImageView fx:id="imageView" fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true" style="-fx-background-radius: 8;" />
                                                        <Label style="-fx-text-fill: #A0522D; -fx-font-size: 10px;" text="120x120 preview" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>
                                                
                                        <!-- Action Buttons -->
                                        <HBox alignment="CENTER" spacing="10.0">
                                            <children>
                                                <Button onAction="#handleAddButton" prefWidth="80.0" style="-fx-background-color: #228B22; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 8; -fx-font-weight: bold; -fx-font-size: 11px;" text="Add" />
                                                <Button onAction="#handleUpdateButton" prefWidth="80.0" style="-fx-background-color: #CD853F; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 8; -fx-font-weight: bold; -fx-font-size: 11px;" text="Update" />
                                                <Button onAction="#handleDeleteButton" prefWidth="80.0" style="-fx-background-color: #B22222; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 8; -fx-font-weight: bold; -fx-font-size: 11px;" text="Delete" />
                                                <Button onAction="#handleClearButton" prefWidth="80.0" style="-fx-background-color: #A0522D; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 8; -fx-font-weight: bold; -fx-font-size: 11px;" text="Clear" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                                        
                                <!-- Right Side: Table Section -->
                                <VBox spacing="10.0" style="-fx-background-color: #FAEBD7; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(139,69,19,0.2), 5, 0, 0, 2);" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #8B4513;" text="Product Inventory" />
                                                <Label fx:id="recordCountLabel" style="-fx-font-size: 12px; -fx-text-fill: #A0522D; -fx-background-color: #F5DEB3; -fx-padding: 5 10; -fx-background-radius: 15;" text="0 items" />
                                            </children>
                                        </HBox>
                                                
                                        <TableView fx:id="productTable" prefHeight="500.0" style="-fx-background-color: #F5DEB3; -fx-border-color: #D2B48C; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="idColumn" prefWidth="60.0" style="-fx-alignment: CENTER;" text="ID" />
                                                <TableColumn fx:id="nameColumn" prefWidth="180.0" text="Product Name" />
                                                <TableColumn fx:id="priceColumn" prefWidth="100.0" style="-fx-alignment: CENTER_RIGHT;" text="Price ($)" />
                                                <TableColumn fx:id="stockColumn" prefWidth="80.0" style="-fx-alignment: CENTER;" text="Stock" />
                                                <TableColumn fx:id="categoryColumn" prefWidth="120.0" text="Category" />
                                                <TableColumn fx:id="imageColumn" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Image" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>
