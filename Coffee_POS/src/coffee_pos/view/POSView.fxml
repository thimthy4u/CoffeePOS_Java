<BorderPane style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="coffee_pos.controller.POSController">
    <center>
        <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
            <children>
                <TextField fx:id="searchField" promptText="Search products..." style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-font-size: 14px;">
                    <VBox.margin>
                        <Insets bottom="10.0" left="15.0" right="15.0" top="15.0" />
                    </VBox.margin>
                </TextField>
                <FlowPane fx:id="categoryFilterBox" hgap="10" style="-fx-background-color: #f8f9fa;" vgap="10">
                    <padding>
                        <Insets bottom="10" left="15" right="15" />
                    </padding>
                </FlowPane>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: white; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="productGrid" hgap="15" prefHeight="627.0" prefWidth="431.0" style="-fx-background-color: white;" vgap="15">
                            <padding>
                                <Insets bottom="15" left="15" right="15" top="15" />
                            </padding>
                        </FlowPane>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </center>
    <right>
        <VBox prefWidth="350" spacing="10" style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-width: 0 0 0 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
            <children>
                <Label prefHeight="58.0" prefWidth="326.0" style="-fx-background-color: #3498db; -fx-alignment: center; -fx-text-fill: white; -fx-padding: 15px; -fx-background-radius: 5px;" text="Current Order">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <TableView fx:id="orderTable" prefHeight="400.0" style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-width: 1px;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="nameColumn" prefWidth="150.0" text="Item" />
                        <TableColumn fx:id="quantityColumn" prefWidth="60.0" text="Qty" />
                        <TableColumn fx:id="priceColumn" prefWidth="100.0" text="Total" />
                    </columns>
                </TableView>
                <VBox spacing="5" style="-fx-background-color: #f8f9fa; -fx-padding: 15px; -fx-background-radius: 5px;">
                    <children>
                        <Label fx:id="subtotalLabel" style="-fx-text-fill: #495057;" text="Subtotal: $0.00">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <Label fx:id="taxLabel" style="-fx-text-fill: #495057;" text="Tax (12%): $0.00">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <Label fx:id="totalLabel" style="-fx-text-fill: #28a745; -fx-font-weight: bold;" text="Total: $0.00">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
                <VBox spacing="5">
                    <children>
                        <Button onAction="#handlePayButton" prefHeight="40.0" prefWidth="Infinity" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-background-radius: 5px; -fx-font-weight: bold; -fx-font-size: 16px;" text="Pay" />
                        <Button onAction="#handleClearButton" prefHeight="40.0" prefWidth="Infinity" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-background-radius: 5px; -fx-font-weight: bold;" text="Clear Order" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </right>
</BorderPane>
