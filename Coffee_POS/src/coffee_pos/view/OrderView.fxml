<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.control.Separator?>

<BorderPane style="-fx-background-color: #f5f1eb;" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="coffee_pos.controller.OrderController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    
        
    <center>
        <VBox spacing="15.0" style="-fx-padding: 15 0 0 0;">
            <children>
                <VBox spacing="10.0" style="-fx-background-color: #FAEBD7; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(139,69,19,0.2), 5, 0, 0, 2);">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #8B4513;" text="Order Summary" />
                                <Label fx:id="selectedOrderLabel" style="-fx-font-size: 12px; -fx-text-fill: #A0522D; -fx-background-color: #F5DEB3; -fx-padding: 5 10; -fx-background-radius: 15;" text="Select an order to view details" />
                            </children>
                        </HBox>
                        
                        <TableView fx:id="ordersTable" prefHeight="250.0" style="-fx-background-color: #F5DEB3; -fx-border-color: #D2B48C; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-radius: 8;">
                            <columns>
                                <TableColumn fx:id="orderIdColumn" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Order ID" />
                                <TableColumn fx:id="orderDateColumn" prefWidth="200.0" style="-fx-alignment: CENTER;" text="Order Date" />
                                <TableColumn fx:id="orderTotalColumn" prefWidth="120.0" style="-fx-alignment: CENTER_RIGHT;" text="Total ($)" />
                                <TableColumn fx:id="orderItemCountColumn" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Items" />
                                <TableColumn fx:id="orderStatusColumn" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Status" />
                                <TableColumn fx:id="orderCustomerColumn" prefWidth="150.0" text="Customer" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
                
                <VBox spacing="10.0" style="-fx-background-color: #FAEBD7; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(139,69,19,0.2), 5, 0, 0, 2);" VBox.vgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <children>
                                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #8B4513;" text="Order Details" />
                                <Separator orientation="VERTICAL" />
                                <Label fx:id="orderDetailsInfoLabel" style="-fx-font-size: 12px; -fx-text-fill: #A0522D;" text="Order information will appear here when an order is selected" />
                            </children>
                        </HBox>
                        
                        
                        
                        <TableView fx:id="orderItemsTable" prefHeight="200.0" style="-fx-background-color: #F5DEB3; -fx-border-color: #D2B48C; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="orderItemNameColumn" prefWidth="250.0" text="Product Name" />
                                <TableColumn fx:id="orderItemQuantityColumn" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Quantity" />
                                <TableColumn fx:id="orderItemPriceColumn" prefWidth="120.0" style="-fx-alignment: CENTER_RIGHT;" text="Price ($)" />
                                <TableColumn fx:id="orderItemTotalColumn" prefWidth="120.0" style="-fx-alignment: CENTER_RIGHT;" text="Subtotal ($)" />
                                <TableColumn fx:id="orderItemCategoryColumn" prefWidth="150.0" text="Category" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                        
                      
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>


