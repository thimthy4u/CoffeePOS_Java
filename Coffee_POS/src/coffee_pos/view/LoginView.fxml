<VBox alignment="CENTER" fillWidth="false" prefHeight="510.0" prefWidth="450" spacing="10.0" style="-fx-background-color: linear-gradient(to bottom, #f8f9fa, #e9ecef); -fx-background-radius: 15;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="coffee_pos.controller.LoginController">
    
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    
    <effect>
        <DropShadow color="#00000030" offsetX="0" offsetY="5" radius="15" />
    </effect>
    
    <children>
        <!-- Header Section -->
        <VBox alignment="CENTER" prefHeight="100.0" prefWidth="158.0">
            <children>
                <!-- Coffee Logo/Icon -->
                <ImageView fitHeight="123.0" fitWidth="148.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../icons/logo.png" />
                    </image>
                </ImageView>
                
                <!-- Title -->
                <Label text="Coffee POS" textFill="#8B4513">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>
                
                <!-- Subtitle -->
                <Label text="Please sign in to continue" textFill="#6c757d">
                    <font>
                        <Font size="14.0" />
                    </font>
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
                </Label>
            </children>
        </VBox>

        <!-- Form Section -->
        <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 25;">
            <effect>
                <DropShadow color="#00000020" offsetX="0" offsetY="2" radius="10" />
            </effect>
            
            <children>
                <!-- Username Field -->
                <VBox spacing="8.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <children>
                                <ImageView fitHeight="16" fitWidth="16" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../icons/user.png" />
                                    </image>
                                </ImageView>
                                <Label text="Username" textFill="#495057">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                        <TextField fx:id="usernameField" onKeyPressed="#handleEnterKey" onMouseEntered="#handleFieldHover" onMouseExited="#handleFieldExit" promptText="Enter your username" style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 12; -fx-font-size: 14;" />
                    </children>
                </VBox>

                <!-- Password Field -->
                <VBox spacing="8">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <children>
                                <ImageView fitHeight="16" fitWidth="16" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../icons/reset-password.png" />
                                    </image>
                                </ImageView>
                                <Label text="Password" textFill="#495057">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                        <PasswordField fx:id="passwordField" onKeyPressed="#handleEnterKey" onMouseEntered="#handleFieldHover" onMouseExited="#handleFieldExit" promptText="Enter your password" style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 12; -fx-font-size: 14;" />
                    </children>
                </VBox>

                <!-- Login Button -->
                <Button fx:id="loginButton" onAction="#handleLogin" onMouseEntered="#handleButtonHover" onMouseExited="#handleButtonExit" prefWidth="Infinity" style="-fx-background-color: linear-gradient(to bottom, #007bff, #0056b3); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16; -fx-background-radius: 8; -fx-cursor: hand;" text="Sign In">
                    <padding>
                        <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
                    </padding>
                    <effect>
                        <DropShadow color="#007bff40" offsetX="0" offsetY="3" radius="5" />
                    </effect>
                </Button>
            </children>
        </VBox>

        <!-- Register Link -->
        <HBox alignment="CENTER" spacing="5">
            <children>
                <Label text="Don't have an account?" textFill="#6c757d">
                    <font>
                        <Font size="13.0" />
                    </font>
               <HBox.margin>
                  <Insets top="10.0" />
               </HBox.margin>
                </Label>
                <Hyperlink onAction="#handleShowRegister" style="-fx-text-fill: #8B4513; -fx-font-weight: bold; -fx-font-size: 13;" text="Register here">
               <padding>
                  <Insets top="10.0" />
               </padding></Hyperlink>
            </children>
        </HBox>

        <!-- Status/Error Message Label -->
        <Label fx:id="statusLabel" textFill="#dc3545" visible="false">
            <font>
                <Font size="12.0" />
            </font>
        </Label>
    </children>
</VBox>
