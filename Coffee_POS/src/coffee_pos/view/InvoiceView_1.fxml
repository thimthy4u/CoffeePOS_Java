<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="coffee_pos.controller.InvoiceController" prefHeight="500.0" prefWidth="400.0">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <top>
        <Label text="Invoice" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
    </top>
    <center>
        <TextArea fx:id="invoiceTextArea" editable="false" wrapText="true" />
    </center>
    <bottom>
        <VBox alignment="CENTER" spacing="10.0">
            <children>
                <Button text="Print to Console" onAction="#handlePrintToConsole" />
                <Button text="Close" onAction="#handleClose" />
            </children>
        </VBox>
    </bottom>
</BorderPane>
