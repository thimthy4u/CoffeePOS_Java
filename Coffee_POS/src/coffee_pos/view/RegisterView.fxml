<VBox alignment="CENTER" prefHeight="500" prefWidth="450" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="coffee_pos.controller.RegisterController">
    
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    
    <children>
        <!-- Header Section -->
        <VBox alignment="CENTER" spacing="10.0">
            <children>
                <Label text="☕ Coffee POS" textFill="#8B4513">
                    <font>
                        <Font name="System Bold" size="35.0" />
                    </font>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
                </Label>
                <Label text="Create New Account" textFill="#2c3e50">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>
                <Label text="Join our coffee community today" textFill="#7f8c8d">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
            </children>
         <VBox.margin>
            <Insets />
         </VBox.margin>
        </VBox>
        
        <!-- Spacer -->
        <Region prefHeight="10.0" />
        
        <!-- Form Container -->
        <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 25;">
            <effect>
                <DropShadow color="#00000020" offsetY="2" radius="10" />
            </effect>
            
            <children>
                <!-- Username Field -->
                <VBox spacing="8">
                    <children>
                        <Label text="Username" textFill="#34495e">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="usernameField" prefHeight="45" promptText="Enter a username" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #bdc3c7; -fx-border-width: 1.5; -fx-padding: 10; -fx-font-size: 14;">
                        </TextField>
                    </children>
                </VBox>
                
                <!-- Password Field -->
                <VBox spacing="8">
                    <children>
                        <Label text="Password" textFill="#34495e">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <PasswordField fx:id="passwordField" prefHeight="45" promptText="Enter a password" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #bdc3c7; -fx-border-width: 1.5; -fx-padding: 10; -fx-font-size: 14;">
                        </PasswordField>
                    </children>
                </VBox>
                
                <!-- Confirm Password Field -->
                <VBox spacing="8">
                    <children>
                        <Label text="Confirm Password" textFill="#34495e">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <PasswordField fx:id="confirmPasswordField" prefHeight="45" promptText="Confirm your password" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #bdc3c7; -fx-border-width: 1.5; -fx-padding: 10; -fx-font-size: 14;">
                        </PasswordField>
                    </children>
                </VBox>
                
                <!-- Register Button -->
                <Button onAction="#handleRegister" prefHeight="50" prefWidth="Infinity" style="-fx-background-color: linear-gradient(to bottom, #007bff, #0056b3); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16; -fx-background-radius: 8; -fx-cursor: hand;" text="Create Account">
                    <effect>
                        <DropShadow color="#00000030" offsetY="2" radius="5" />
                    </effect>
                </Button>
                
                <!-- Password Requirements -->
                <Label text="Password must be at least 8 characters long" textFill="#95a5a6" wrapText="true">
                    <font>
                        <Font size="12.0" />
                    </font>
                </Label>
            </children>
        </VBox>
        
        <!-- Login Link -->
        <HBox alignment="CENTER" spacing="5">
            <children>
                <Label text="Already have an account?" textFill="#7f8c8d">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <Hyperlink onAction="#handleShowLogin" style="-fx-underline: false; -fx-font-weight: bold;" text="Sign In" textFill="#3498db">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Hyperlink>
            </children>
        </HBox>
    </children>
</VBox>
